{
  "manifest_version": 3,
  "key": "",
  "name": "TubeLens — open YouTube growth toolkit",
  "short_name": "TubeLens",
  "version": "1.4.0",
  "description": "Бесплатный open-source набор инструментов для роста на YouTube: ключевые слова, SEO-оценка, аудит канала, конкуренты, тренды и AI с вашим собственным API.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "TubeLens",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "app/app.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "sidePanel",
    "contextMenus",
    "nativeMessaging",
    "downloads",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://suggestqueries.google.com/*",
    "https://suggestqueries-clients6.youtube.com/*",
    "https://www.youtube.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content/theme.js",
        "content/youtube.js",
        "content/filters.js",
        "content/masthead.js"
      ],
      "css": [
        "content/youtube.css",
        "content/filters.css",
        "content/masthead.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "optional_permissions": [
    "alarms",
    "notifications"
  ]
}
